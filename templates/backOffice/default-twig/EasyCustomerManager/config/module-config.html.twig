{# Config hook fragment — rendered by EasyCustomerManager\Hook\ConfigHook::onModuleConfiguration #}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Ids des statuts correspondant à "payé"</h3>
    </div>
    <div class="card-body">
        <form method="POST" action="{{ path('easy_customer_manager.config.save') }}">
            <input type="hidden" name="{{ form.vars.full_name }}[_token]" value="{{ form._token.vars.value }}">

            {% if form.order.vars.errors|length %}
                <div class="alert alert-danger">{{ form_errors(form.order) }}</div>
            {% endif %}

            <div class="input-group col-md-4">
                <input type="text"
                       name="{{ form.order.vars.full_name }}"
                       class="form-control{{ form.order.vars.errors|length ? ' is-invalid' : '' }}"
                       value="{{ form.order.vars.value }}">
                <button type="submit" class="btn btn-secondary">Set</button>
            </div>
        </form>

        <p class="form-text mt-2">
            Entrer les identifiants des statuts de commande qui seront pris en compte comme payé dans le calcul du chiffre d'affaire par client (exemple: 2,4)
        </p>

        <hr>

        <div class="table-responsive">
            <table class="table table-striped">
                <caption>Statuts de commande</caption>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Titre</th>
                    <th>Commandes</th>
                    <th>Position</th>
                    {{ safe_hook('order-status.table-header') }}
                    <th class="actions">Action</th>
                </tr>
                </thead>
                <tbody>
                {% for status in order_statuses %}
                    <tr>
                        <td>
                            <a href="{{ path('admin.order-status.update', {order_status_id: status.id}) }}">{{ status.id }}</a>
                        </td>
                        <td>
                            <a href="{{ path('admin.order-status.update', {order_status_id: status.id}) }}">{{ status.code }}</a>
                        </td>
                        <td>
                            <a class="badge text-decoration-none" style="background-color: {{ status.color }};" href="{{ path('admin.order-status.update', {order_status_id: status.id}) }}">{{ status.title }}</a>
                        </td>
                        <td>
                            <a href="{{ path('admin.order.list', {status: status.id}) }}">{{ status.orderCount }}</a>
                        </td>
                        <td>{{ status.position }}</td>
                        {{ safe_hook('order-status.table-row', {order_status_id: status.id}) }}
                        <td class="actions">
                            {% if is_granted('UPDATE', 'admin.order-status') %}
                                <a title="Modifier le statut" href="{{ path('admin.order-status.update', {order_status_id: status.id}) }}"><i class="bi bi-pencil"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
