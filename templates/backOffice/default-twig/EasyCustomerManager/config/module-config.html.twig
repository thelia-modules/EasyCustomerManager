{# Rendered by EasyCustomerManager\Hook\ConfigHook inside the module configuration page #}
{% set domain = 'easycustomermanager' %}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title h5 mb-0">{{ 'Order statuses counted as paid'|trans({}, domain) }}</h3>
    </div>
    <div class="card-body">
        {% form_theme form with bo_form_themes only %}
        {{ form_start(form, {action: path('easy_customer_manager.configuration.save'), method: 'post'}) }}
            <div class="row align-items-end">
                <div class="col-md-4">{{ form_row(form.order) }}</div>
                <div class="col-md-2 mb-3">
                    <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
                </div>
            </div>
            <p class="form-text">{{ 'Enter the ids of the order statuses counted as paid in the revenue of each customer (for example 2,4).'|trans({}, domain) }}</p>
        {{ form_end(form) }}

        <hr>

        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <caption>{{ 'Order statuses'|trans({}, domain) }}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{ 'Id'|trans }}</th>
                        <th scope="col">{{ 'Code'|trans }}</th>
                        <th scope="col">{{ 'Title'|trans }}</th>
                        <th scope="col">{{ 'Orders'|trans({}, domain) }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for status in order_statuses %}
                        <tr>
                            <td>{{ status.id }}</td>
                            <td>{{ status.code }}</td>
                            <td><span class="badge" style="background-color: {{ status.color }};">{{ status.title }}</span></td>
                            <td><a href="{{ path('admin.order.list', {status_ids: [status.id]}) }}">{{ status.orderCount }}</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
