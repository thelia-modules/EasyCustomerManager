{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}Gestion des clients avec EasyCustomerManager{% endblock %}

{% block head_extra %}
<link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/dataTables.bootstrap.min.css">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/css/select2.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2-bootstrap-css/1.4.6/select2-bootstrap.min.css" rel="stylesheet" />
<style>
    .js-list {
        width: 100% !important;
    }
    .js-animate-info-button {
        animation: AnimateInfoButton 2s infinite;
    }
    @keyframes AnimateInfoButton{
        0%{opacity: 1;}
        50%{opacity: 0;}
        100%{opacity: 1;}
    }
</style>
{% endblock %}

{% block content %}
<div id="module-easy-customer-manager">
    <div id="wrapper" class="container">
        <div class="row">
            <div class="col-md-12 card card-body">
                <div class="row align-items-center">
                    <div class="col-md-3 filter">
                        <div class="mb-3">
                            <label for="js-input-search-customer">Rechercher Client</label>
                            <input type="text" class="form-control js-refresh-table" data-default="" id="js-input-search-customer" placeholder="Nom, prénom, email, référence ou id">
                        </div>
                    </div>
                    <div class="col-md-2 filter">
                        <div class="mb-3">
                            <label for="js-input-country">Pays</label>
                            <select id="js-input-country" class="form-control js-refresh-table">
                                <option value="">Aucun pays sélectionné</option>
                                {% for country in countries %}
                                <option value="{{ country.id }}">{{ country.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2 filter">
                        <label class="form-label" for="js-input-created-at-from">Date d'enregistrement, à partir de</label>
                        <div class="input-group">
                            <input type="date" id="js-input-created-at-from" class="form-control js-refresh-table" />
                        </div>
                    </div>
                    <div class="col-md-2 filter">
                        <div class="mb-3">
                            <label class="form-label" for="js-input-created-at-to">Jusqu'au</label>
                            <div class="input-group">
                                <input type="date" id="js-input-created-at-to" class="form-control js-refresh-table" value="" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 filter">
                        <label for="js-input-length">Nombre d'éléments</label>
                        <select id="js-input-length" class="form-control js-refresh-table">
                            <option value="10">10</option>
                            <option value="25" selected>25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2 filter">
                        <div class="mb-3">
                            <button id="delete-selected-items" class="btn btn-danger">Supprimer les éléments sélectionnés</button>
                        </div>
                    </div>
                </div>

                <div class="row">
                    {% for template in template_fields %}
                        {% include template ignore missing %}
                    {% endfor %}
                </div>
                <div class="row">
                    <div class="col-md-12 filter">
                        <table class="js-list table table-striped table-bordered">
                            <thead>
                            <tr>
                                {% for definition in columnsDefinition %}
                                <td>{{ definition.title|raw }}</td>
                                {% endfor %}
                            </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Info -->
    <div class="modal fade" id="modal-info" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Informations module</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <iframe width="100%" frameborder="0" height="300" src="https://www.gilles-bourgeat.fr/thelia/module/easy-product-manager?tv={{ theliaVersion }}&mv={{ moduleVersion }}&mn={{ moduleName }}&lang={{ app.request.session.lang.locale }}">
                    </iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal-delete-selected" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Supprimer les clients sélectionnés</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Êtes-vous sûr de vouloir supprimer les clients sélectionnés ?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-danger" id="confirm-delete-selected">Supprimer</button>
                </div>
            </div>
        </div>
    </div>

    {# Delete confirmation dialog (single customer) #}
    <div class="modal fade" id="delete_customer_dialog" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form id="form_delete_customer" method="post" action="{{ path('admin.customer.delete') }}?_token={{ assignToken() }}">
                    <div class="modal-header">
                        <h5 class="modal-title">Supprimer le client</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Voulez-vous vraiment supprimer ce client ?
                        <input type="hidden" name="customer_id" id="delete_customer_id">
                        {{ safe_hook('customer.delete-form') }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts_extra %}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.10/lodash.min.js"></script>
<script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.16/js/dataTables.bootstrap.min.js"></script>

<script>
    "use strict";
    (function($, $module) {
        $('#page-wrapper .page-header').append('<button class="btn btn-info js-module-easy-customer-manager-info float-end"><i class="bi bi-info-circle"></i></button>');

        $( "#js-input-country" ).select2();

        var tv = '{{ theliaVersion }}', mv = '{{ moduleVersion }}', mn = '{{ moduleName }}', id = $module.attr('id');
        var $modalDelete = $module.find('#delete_customer_dialog');

        var table = $module.find('.js-list').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                lengthChange: false,
                scrollX: true,
                order: [[ 1, "desc" ]],
                ajax: {
                    url: "{{ path('back') }}",
                    method: 'POST',
                    data: function (data) {
                        data.filter = {
                            searchCustomer: $module.find('#js-input-search-customer').val(),
                            country: $module.find('#js-input-country').val(),
                            createdAtFrom: $module.find('#js-input-created-at-from').val(),
                            createdAtTo: $module.find('#js-input-created-at-to').val()
                        };

                        [...document.querySelectorAll(".js-filter-element")].forEach(el => {
                            data.filter[el.name] = el.value;
                        });

                        data.searchCustomer = {
                            "value": $module.find('#js-input-search-customer').val(),
                            regex: false
                        };

                        data.length = $module.find('#js-input-length').val();
                    }
                },
                displayLength: 25,
                columnDefs: {{ columnsDefinition|json_encode|raw }}.concat([
                {
                    className: "text-center",
                    targets: [5, 6, 7, 8],
                    render: function (data, type, row, meta) {
                        return data;
                    }
                },
                {
                    className: "text-center",
                    targets: [1, 2, 3],
                    render: function (data, type, row, meta) {
                        if (data !== '') {
                            return '<a href="' + data['href'] + '">' + data['name'] + '</a>';
                        }
                        return '<a href="#" style="line-height:50px;text-align:center;width: 50px; height: 50px;">Aucune</a>';
                    }
                },
                {
                    className: "text-end",
                    targets: 4,
                    render: function (data, type, row, meta) {
                        return '<a href="mailto:' + data['email'] + '">' + data['email'] + '</a>';
                    }
                },
                {
                    className: "text-end",
                    targets: 9,
                    render: function (data, type, row, meta) {
                        return '<a href="' + data['hrefUpdate'] + '" class="btn btn-info" title="Modifier">' +
                            '<i class="bi bi-pencil"></i>' +
                            '</a>' +
                            ' <a href="#" class="btn btn-danger js-action-delete" title="Supprimer" data-id="' + data['customer_id'] + '">' +
                            '<i class="bi bi-trash"></i>' +
                            '</a>';
                    }
                },
                {
                    className: "text-center",
                    targets: 0,
                    render: function (data, type, row, meta) {
                        return '<input type="checkbox" class="select_customer" data-id="' + data['customer_ids'] + '">';
                    }
                }
            ]),
            language: {
                "sProcessing": "Traitement en cours...",
                "sSearch": "Rechercher&nbsp;:",
                "sLengthMenu": "Afficher _MENU_ &eacute;l&eacute;ments",
                "sInfo": "Affichage de l'&eacute;l&eacute;ment _START_ &agrave; _END_ sur _TOTAL_ &eacute;l&eacute;ments",
                "sInfoEmpty": "Affichage de l'&eacute;l&eacute;ment 0 &agrave; 0 sur 0 &eacute;l&eacute;ment",
                "sInfoFiltered": "(filtr&eacute; de _MAX_ &eacute;l&eacute;ments au total)",
                "sInfoPostFix": "",
                "sLoadingRecords": "Chargement en cours...",
                "sZeroRecords": "Aucun &eacute;l&eacute;ment &agrave; afficher",
                "sEmptyTable": "Aucune donn&eacute;e disponible dans le tableau",
                "oPaginate": {
                    "sFirst": "Premier",
                    "sPrevious": "Pr&eacute;c&eacute;dent",
                    "sNext": "Suivant",
                    "sLast": "Dernier"
                },
                "oAria": {
                    "sSortAscending": ": activer pour trier la colonne par ordre croissant",
                    "sSortDescending": ": activer pour trier la colonne par ordre d&eacute;croissant"
                }
            }
        });

        var filters = $module.find('.js-refresh-table');
        function refreshFilter() {
            filters.each(function () {
                if ('undefined' !== typeof this.dataset.default) {
                    var val = $(this).val();
                    if (val === null) {
                        val = '';
                    }
                    if (val !== this.dataset.default) {
                        $(this).parents('.filter:eq(0)').css('backgroundColor', 'rgba(0, 102, 255, 0.1)');
                    } else {
                        $(this).parents('.filter:eq(0)').css('backgroundColor', '');
                    }
                }
            });
        }

        var timer = null;
        $module.find('.js-refresh-table').on('change keyup', function (event) {
            if (event.type === "keyup") {
                if (timer !== null) {
                    clearTimeout(timer);
                }
                timer = setTimeout(function () {
                    refreshFilter();
                    table.ajax.reload();
                }, 350);
            } else {
                refreshFilter();
                table.ajax.reload();
            }
        });

        table.on('click', '.js-action-delete', function (e) {
            e.preventDefault();
            $modalDelete.find('#delete_customer_id').val($(this).data('id'));
            bootstrap.Modal.getOrCreateInstance($modalDelete[0]).show();
        });

        $(document).ready(function() {
            $('#select-all').on('click', function() {
                var rows = $('.js-list').DataTable().rows({ 'search': 'applied' }).nodes();
                $('input[type="checkbox"]', rows).prop('checked', this.checked);
            });

            $('#delete-selected-items').on('click', function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-delete-selected')).show();
            });

            $('#confirm-delete-selected').on('click', function () {
                var selectedIds = [];
                $('.select_customer:checked').each(function () {
                    selectedIds.push($(this).data('id'));
                });

                if (selectedIds.length > 0) {
                    $.ajax({
                        url: "{{ path('delete_selected') }}?_token={{ assignToken() }}",
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ customer_ids: selectedIds }),
                        success: function (response) {
                            var message = '';

                            if (response.deleted_customers && response.deleted_customers.length > 0) {
                                message += 'Les clients suivants ont été supprimés avec succès : ' + response.deleted_customers.join(', ') + '. ';
                            }

                            if (response.not_deleted_customers && response.not_deleted_customers.length > 0) {
                                message += 'Les clients suivants n\'ont pas pu être supprimés car ils ont des commandes : ' + response.not_deleted_customers.join(', ') + '.';
                            }

                            if (message === '') {
                                message = 'Aucun client n\'a été supprimé.';
                            }

                            alert(message);

                            $('.js-list').DataTable().ajax.reload();
                            $('#select-all').prop('checked', false);
                            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-delete-selected')).hide();
                        },
                        error: function (xhr, status, error) {
                            alert('Une erreur est survenue : ' + error);
                        }
                    });
                } else {
                    alert('Aucun client sélectionné.');
                }
            });
        });

        $('.js-module-easy-customer-manager-info').on('click', function () {
            bootstrap.Modal.getOrCreateInstance($module.find('#modal-info')[0]).show();
            $(this).removeClass('js-animate-info-button');
        });

        window.addEventListener("message", function (event) {
            if (event.origin === "https://www.gilles-bourgeat.fr" && event.data === 'new') {
                $('.js-module-easy-customer-manager-info').addClass('js-animate-info-button');
            }
        }, false);

    }(jQuery, jQuery('#module-easy-customer-manager')));
</script>
{% endblock %}
